# Copy to .env beside sources.json. Existing process environment takes precedence.
# Each RuntimeSettings JSON field also accepts DATA_AGENT_<FIELD_NAME_UPPERCASE>.
# Examples (uncomment to override settings.json):
# DATA_AGENT_QUERY_MAX_ROWS=2000
# DATA_AGENT_QUERY_DEFAULT_MAX_ROWS=200
# DATA_AGENT_RESPONSE_MAX_BYTES=1000000
# DATA_AGENT_PROFILE_MAX_SAMPLE_ROWS=5000
# DATA_AGENT_DATABASE_CONCURRENCY=2
# DATA_AGENT_QUERY_TIMEOUT_SECONDS=30
# DATA_AGENT_LOCK_TIMEOUT_MILLISECONDS=5000
# DATA_AGENT_QUERY_CELL_MAX_BYTES=65536
# Paths below are relative to the source configuration directory.
# DATA_AGENT_SETTINGS_FILE=settings.json
# DATA_AGENT_STATE_FILE=state/metadata.sqlite3

# Optional cloud embeddings. Leave the key empty to use keyword search only.
DATA_AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
DATA_AGENT_EMBEDDING_MODEL=text-embedding-3-small
DATA_AGENT_EMBEDDING_KEY_REFERENCE=DATA_AGENT_EMBEDDING_API_KEY
DATA_AGENT_EMBEDDING_API_KEY=

# SQL authentication passwords remain local. The name must match password_reference.
# DATA_AGENT_REMOTE_SQL_PASSWORD=

# Alternatively, set these in Windows User environment variables (not in this file).
# sources.json can use username_reference and password_reference with these names.
# DATA_AGENT_USERNAME=
# DATA_AGENT_PASSWORD=
